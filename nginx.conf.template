# Nginx Configuration Template for AlgoFlow Stateful VM Deployment
# Place this at /etc/nginx/sites-available/algoflow on the host VM, then symlink to sites-enabled.

server {
    listen 80;
    listen [::]:80;
    server_name algoflow.yourdomain.com; # Replace with your domain name or public IP

    # Redirect all HTTP traffic to HTTPS (uncomment after Certbot setup)
    # return 301 https://$host$request_uri;
    
    location / {
        proxy_pass http://localhost:8000;
        
        # Enable HTTP/1.1 for keepalive connections
        proxy_http_version 1.1;
        
        # Configure WebSocket upgrading
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # Forward client headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Disable caching for real-time WebSocket streams
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

