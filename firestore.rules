rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Authenticated users can read their own profile details
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Users can write progress checklists and heuristics notes, 
      // but CANNOT modify the 'isPro' status directly!
      allow write: if request.auth != null && request.auth.uid == userId 
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPro']));
    }
  }
}
